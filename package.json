{
  "name": "career-intelligence-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-based career intelligence platform for students and recruiters.",
  "type": "module",
  "workspaces": [
    "packages/frontend",
    "packages/api",
    "packages/shared",
    "packages/database"
  ],
  "scripts": {
    "dev:frontend": "npm --workspace @career/frontend run dev",
    "dev:api": "npm --workspace @career/api run dev",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "eslint": "^9.26.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  },
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "mongodb-memory-server@10.4.3": true
  }
}
