# ---- General ----
NODE_ENV=development
LOG_LEVEL=info
APP_NAME=Career Intelligence Platform

# ---- Services ----
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Data stores ----
MONGODB_URI=mongodb://localhost:27017/career_intelligence

# ---- Execution sandbox (data-service) ----
DATA_SERVICE_URL=http://localhost:8000
DATA_SERVICE_API_KEY=change-me

# ---- AI coach (optional) ----
# An OpenAI-compatible chat completions endpoint.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- Optional ML reranker (legacy-ml) ----
ML_API_URL=
ML_API_KEY=

# ---- Email (optional; falls back to console log) ----
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@careerlens.example
# Alternate cheap channel: POSTs {to,subject,text,html} to this webhook.
MAILHOOK_URL=

# ---- Uploads ----
MAX_UPLOAD_SIZE_MB=2
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/png,image/jpeg

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100