# =============================================================================
# Career Intelligence Platform - environment configuration
# Copy to .env and fill in real values. NEVER commit the real .env file.
# =============================================================================

# --- Application ---
NODE_ENV=development
APP_NAME=Career Intelligence Platform
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
DATA_SERVICE_URL=http://localhost:8000

# --- Database (MongoDB) ---
# Local: mongodb://localhost:27017/career_intelligence
# Atlas: mongodb+srv://<user>:<password>@<cluster>/career_intelligence
MONGODB_URI=mongodb://localhost:27017/career_intelligence

# --- Authentication ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- File uploads ---
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/png,image/jpeg

# --- Data service (Python/FastAPI) ---
DATA_SERVICE_API_KEY=change-me

# --- GitHub (public data only) ---
# GITHUB_TOKEN=

# --- Logging ---
LOG_LEVEL=info